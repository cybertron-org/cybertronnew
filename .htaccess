
<IfModule mod_rewrite.c>
RewriteEngine On
RewriteBase /

# ==========================================
# 1. SECURITY
# ==========================================

# Block access to Git metadata
RewriteRule (^|/)\.git(/|$) - [F,L,NC]

# Block access to hidden files
# Allow .well-known for SSL verification
RewriteRule (^|/)\.(?!well-known(?:/|$)) - [F,L]

# ==========================================
# 2. REMOVE .PHP EXTENSION
# ==========================================

# /join.php -> /join/
# /contact-us.php -> /contact-us/

RewriteCond %{THE_REQUEST} \s/+(.+?)\.php(?:[\s?]|$) [NC]
RewriteRule ^(.+)\.php$ /$1/ [R=301,L,NE]

# ==========================================
# 3. CLEAN URLS WITH TRAILING SLASH
# ==========================================

# /join -> /join/
# Only if join.php exists

RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+[^/])$ /$1/ [R=301,L]

# ==========================================
# 4. INTERNALLY LOAD PHP FILES
# ==========================================

# /join/ -> join.php
# /contact-us/ -> contact-us.php

RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+)/$ $1.php [L]

# ==========================================
# 5. ALLOW EXISTING FILES AND DIRECTORIES
# ==========================================

RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

</IfModule>

# ==========================================
# 6. PROTECT SENSITIVE FILES
# ==========================================

<FilesMatch "^(\.env|\.gitignore|\.htaccess)$">
    Require all denied
</FilesMatch>

# ==========================================
# 7. CUSTOM 404 ERROR PAGE
# ==========================================

ErrorDocument 404 /404.php
